# ==================== MySQL ====================
# 本机运行的后端用 127.0.0.1；容器间互访用服务名 mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3312
MYSQL_DATABASE=drop
MYSQL_USER=drop
MYSQL_PASSWORD=drop
MYSQL_ROOT_PASSWORD=root

# ==================== Redis ====================
# 本机运行的后端用 127.0.0.1；容器间互访用服务名 redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6480

# ==================== 站点 ====================
# 主站
NUXT_PUBLIC_SITE_URL=https://drop.micropue.com.cn
# 用户项目单独走内容域（同源隔离）；本地开发可改成 dropcontent.localhost + http://dropcontent.localhost:3678
NUXT_CONTENT_HOST=dropcontent.micropue.com.cn
NUXT_PUBLIC_CONTENT_URL=https://dropcontent.micropue.com.cn
# 生产让内容域也能识别所有者会话；本地留空
AUTH_COOKIE_DOMAIN=.micropue.com.cn

# ==================== BITS OAuth ====================
# 本地开发 App：MICROPUE Drop Dev（回调必须与 BITS 后台登记的完全一致）
BITS_OAUTH_ORIGIN=https://bits.micropue.com.cn
BITS_OAUTH_CLIENT_ID=
BITS_OAUTH_CLIENT_SECRET=
BITS_OAUTH_REDIRECT_URI=http://localhost:3678/api/auth/bits/callback

# 会话 JWT 签名密钥（openssl rand -hex 32）
AUTH_SECRET=

# 部署测试 App：MICROPUE Drop Staging（部署时替换 BITS_OAUTH_*）
BITS_STAGING_CLIENT_ID=
BITS_STAGING_CLIENT_SECRET=
BITS_STAGING_REDIRECT_URI=https://drop.micropue.com.cn/api/auth/bits/callback
