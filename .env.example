# ==================== MySQL ====================
# 本机运行的后端用 127.0.0.1；容器间互访用服务名 mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3312
MYSQL_DATABASE=drop
MYSQL_USER=drop
MYSQL_PASSWORD=drop
MYSQL_ROOT_PASSWORD=root

# ==================== Redis ====================
